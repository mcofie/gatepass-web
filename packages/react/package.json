{
  "name": "@gatepass/react",
  "version": "0.1.0",
  "description": "GatePass ticket checkout for React and Next.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup src/index.tsx --format esm,cjs --dts --clean --target es2019 --external react --external @gatepass/js" },
  "keywords": ["gatepass", "tickets", "checkout", "react", "nextjs"],
  "homepage": "https://gatepass.so",
  "dependencies": { "@gatepass/js": "^0.1.0" },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": { "@types/react": "18.3.12", "react": "18.3.1", "tsup": "8.3.5", "typescript": "5.6.3" }
}
