{
  "name": "@gatepass/vue",
  "version": "0.1.0",
  "description": "GatePass ticket checkout for Vue 3.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2019 --external vue --external @gatepass/js" },
  "keywords": ["gatepass", "tickets", "checkout", "vue"],
  "homepage": "https://gatepass.so",
  "dependencies": { "@gatepass/js": "^0.1.0" },
  "peerDependencies": { "vue": ">=3.3" },
  "devDependencies": { "tsup": "8.3.5", "typescript": "5.6.3", "vue": "3.5.12" }
}
